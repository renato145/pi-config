{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",

  "piInfrastructureReadPaths": [
    "/home/renato/.local/share/nvm/v24.14.0/lib/node_modules/@earendil-works/pi-coding-agent"
  ],

  "permission": {
    "*": "ask",
    "ask_user_question": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": {
      "*": "ask",
      "browser-tools": "ask",
      "javascript-guidelines": "allow",
      "python-guidelines": "allow",
      "rust-guidelines": "allow"
    },
    "read": "allow",
    "write": "ask",
    "edit": "ask",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "web_search": "allow",
    "web_fetch": "allow",
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~/*": "deny",
      "sudo *": "ask",
      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log**": "allow",
      "find *": "allow",
      "sort *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "sed -i *": "ask",
      "sed --in-place *": "ask",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "readlink *": "allow",
      "dirname *": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "mkdir *": "ask",
      "touch *": "ask",
      "sleep *": "allow",
      "~/.pi/agent/skills/browser-tools/browser-*.js *": "allow",
      "~/.pi/agent/skills/browser-tools/browser-start.js *--*profile*": {
        "action": "deny",
        "reason": "Browser profile copying is disabled; use the dedicated browser-tools profile"
      },
      "~/.pi/agent/skills/browser-tools/browser-eval.js *--allow-sensitive*": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/.pi/agent/skills/browser-tools/*": "allow"
    }
  }
}
