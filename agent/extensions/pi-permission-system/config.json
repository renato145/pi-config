{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "permission": {
    "*": "ask",
    "ask_user_question": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "*/.netrc": "deny",
      "*.pem": "ask",
      "*.key": "ask",
      "*id_rsa*": "ask"
    },
    "skill": {
      "*": "ask",
      "javascript-guidelines": "allow",
      "python-guidelines": "allow",
      "rust-guidelines": "allow"
    },
    "read": "allow",
    "write": "ask",
    "edit": "ask",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "web_search": "allow",
    "web_fetch": "allow",
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "rm -rf /": "deny",
      "rm -rf ~/*": "deny",
      "sudo *": "ask",
      "git *": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log**": "allow",
      "find *": "allow",
      "sort *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "sed -i *": "ask",
      "sed --in-place *": "ask",
      "head *": "allow",
      "tail *": "allow",
      "date": "allow",
      "date *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "readlink *": "allow",
      "dirname *": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",
      "cargo fmt*": "allow",
      "mkdir *": "ask",
      "touch *": "ask",
      "sleep *": "allow"
    },
    "external_directory": {
      "*": "ask"
    },
    "external_directory_read": {
      "/tmp/*": "allow",
      "~/.pi/agent/install/*": "allow",
      "~/.pi/agent/skills": "allow",
      "~/.pi/agent/skills/*": "allow"
    }
  },

  "promptNotifications": ["bell"]
}
