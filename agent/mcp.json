{
  "mcpServers": {
    "jupyter": {
      "enabled": false,
      "command": "uvx",
      "args": ["jupyter-mcp-server@latest"],
      "env": {
        "JUPYTER_URL": "http://localhost:8900",
        "JUPYTER_TOKEN": "",
        "ALLOW_IMG_OUTPUT": "true"
      },
      "exposure": "codemode",
      "toolExposure": {
        "read_cell": "direct",
        "execute_cell": "direct",
        "execute_code": "direct",
        "insert_execute_code_cell": "direct"
      },
      "timeout": 600
    }
  }
}
